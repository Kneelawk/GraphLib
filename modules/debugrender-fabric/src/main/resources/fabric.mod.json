{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "Graph Lib Debug Render",
  "description": "Client-side rendering of graphs for debugging server-side graphs.",
  "authors": [
    "Kneelawk"
  ],
  "contact": {
    "homepage": "https://github.com/Kneelawk/GraphLib",
    "issues": "https://github.com/Kneelawk/GraphLib/issues",
    "sources": "https://github.com/Kneelawk/GraphLib"
  },
  "license": "MIT",
  "icon": "assets/${mod_id}/icon-128.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.kneelawk.graphlib.debugrender.fabric.impl.GraphLibDebugRenderFabricMod"
    ],
    "client": [
      "com.kneelawk.graphlib.debugrender.fabric.impl.client.GraphLibDebugRenderFabricModClient"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "graphlib": "*",
    "fabricloader": ">=0.15.10",
    "fabric-api": "*",
    "minecraft": ">=1.21- <1.22-",
    "java": ">=21"
  },
  "custom": {
    "modmenu": {
      "badges": [ "library" ],
      "parent": "graphlib"
    }
  }
}
